# Redirections des anciennes URL .html vers les pages WordPress.
# À coller dans le .htaccess du site, AVANT le bloc « # BEGIN WordPress ».
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^a\-propos\.html$ /a-propos/ [R=301,L]
RewriteRule ^pages/a\-propos\.html$ /a-propos/ [R=301,L]
RewriteRule ^approche\.html$ /approche/ [R=301,L]
RewriteRule ^pages/approche\.html$ /approche/ [R=301,L]
RewriteRule ^conseil\-syndical\.html$ /conseil-syndical/ [R=301,L]
RewriteRule ^pages/conseil\-syndical\.html$ /conseil-syndical/ [R=301,L]
RewriteRule ^contact\.html$ /contact/ [R=301,L]
RewriteRule ^pages/contact\.html$ /contact/ [R=301,L]
RewriteRule ^coproprietaire\.html$ /coproprietaire/ [R=301,L]
RewriteRule ^pages/coproprietaire\.html$ /coproprietaire/ [R=301,L]
RewriteRule ^faq\.html$ /faq/ [R=301,L]
RewriteRule ^pages/faq\.html$ /faq/ [R=301,L]
RewriteRule ^mentions\-legales\.html$ /mentions-legales/ [R=301,L]
RewriteRule ^pages/mentions\-legales\.html$ /mentions-legales/ [R=301,L]
RewriteRule ^plan\-du\-site\.html$ /plan-du-site/ [R=301,L]
RewriteRule ^pages/plan\-du\-site\.html$ /plan-du-site/ [R=301,L]
RewriteRule ^politique\-confidentialite\.html$ /politique-confidentialite/ [R=301,L]
RewriteRule ^pages/politique\-confidentialite\.html$ /politique-confidentialite/ [R=301,L]
RewriteRule ^ressources\-assemblee\-generale\.html$ /ressources-assemblee-generale/ [R=301,L]
RewriteRule ^pages/ressources\-assemblee\-generale\.html$ /ressources-assemblee-generale/ [R=301,L]
RewriteRule ^ressources\-comparer\-devis\-perimetre\-commun\.html$ /ressources-comparer-devis-perimetre-commun/ [R=301,L]
RewriteRule ^pages/ressources\-comparer\-devis\-perimetre\-commun\.html$ /ressources-comparer-devis-perimetre-commun/ [R=301,L]
RewriteRule ^ressources\-contrat\-chauffage\-p1\-p2\-p3\.html$ /ressources-contrat-chauffage-p1-p2-p3/ [R=301,L]
RewriteRule ^pages/ressources\-contrat\-chauffage\-p1\-p2\-p3\.html$ /ressources-contrat-chauffage-p1-p2-p3/ [R=301,L]
RewriteRule ^ressources\-contrat\-syndic\.html$ /ressources-contrat-syndic/ [R=301,L]
RewriteRule ^pages/ressources\-contrat\-syndic\.html$ /ressources-contrat-syndic/ [R=301,L]
RewriteRule ^ressources\-droits\-conseil\-syndical\.html$ /ressources-droits-conseil-syndical/ [R=301,L]
RewriteRule ^pages/ressources\-droits\-conseil\-syndical\.html$ /ressources-droits-conseil-syndical/ [R=301,L]
RewriteRule ^ressources\-forfait\-syndic\-prestations\-particulieres\.html$ /ressources-forfait-syndic-prestations-particulieres/ [R=301,L]
RewriteRule ^pages/ressources\-forfait\-syndic\-prestations\-particulieres\.html$ /ressources-forfait-syndic-prestations-particulieres/ [R=301,L]
RewriteRule ^ressources\-lire\-ses\-charges\.html$ /ressources-lire-ses-charges/ [R=301,L]
RewriteRule ^pages/ressources\-lire\-ses\-charges\.html$ /ressources-lire-ses-charges/ [R=301,L]
RewriteRule ^ressources\-mise\-en\-concurrence\-article\-21\.html$ /ressources-mise-en-concurrence-article-21/ [R=301,L]
RewriteRule ^pages/ressources\-mise\-en\-concurrence\-article\-21\.html$ /ressources-mise-en-concurrence-article-21/ [R=301,L]
RewriteRule ^ressources\-preparer\-budget\-previsionnel\.html$ /ressources-preparer-budget-previsionnel/ [R=301,L]
RewriteRule ^pages/ressources\-preparer\-budget\-previsionnel\.html$ /ressources-preparer-budget-previsionnel/ [R=301,L]
RewriteRule ^ressources\-reconduction\-tacite\-contrats\-entretien\.html$ /ressources-reconduction-tacite-contrats-entretien/ [R=301,L]
RewriteRule ^pages/ressources\-reconduction\-tacite\-contrats\-entretien\.html$ /ressources-reconduction-tacite-contrats-entretien/ [R=301,L]
RewriteRule ^ressources\-registre\-national\.html$ /ressources-registre-national/ [R=301,L]
RewriteRule ^pages/ressources\-registre\-national\.html$ /ressources-registre-national/ [R=301,L]
RewriteRule ^ressources\-renovation\-energetique\.html$ /ressources-renovation-energetique/ [R=301,L]
RewriteRule ^pages/ressources\-renovation\-energetique\.html$ /ressources-renovation-energetique/ [R=301,L]
RewriteRule ^ressources\-reprendre\-copropriete\-pieces\-a\-rassembler\.html$ /ressources-reprendre-copropriete-pieces-a-rassembler/ [R=301,L]
RewriteRule ^pages/ressources\-reprendre\-copropriete\-pieces\-a\-rassembler\.html$ /ressources-reprendre-copropriete-pieces-a-rassembler/ [R=301,L]
RewriteRule ^ressources\.html$ /ressources/ [R=301,L]
RewriteRule ^pages/ressources\.html$ /ressources/ [R=301,L]
RewriteRule ^services\.html$ /services/ [R=301,L]
RewriteRule ^pages/services\.html$ /services/ [R=301,L]
RewriteRule ^syndic\-professionnel\.html$ /syndic-professionnel/ [R=301,L]
RewriteRule ^pages/syndic\-professionnel\.html$ /syndic-professionnel/ [R=301,L]
</IfModule>
